package coiman:plugin@0.5.0;

/// Data shared by the editor and plugins.
interface types {
    /// A row of a tree view declared in `plugin.toml`. Rows with an empty
    /// `parent` are top level; `command` (if any) runs when the row is clicked,
    /// with the row's `id` as its argument.
    record tree-item {
        id: string,
        parent: string,
        label: string,
        description: string,
        tooltip: string,
        command: option<string>,
    }

    /// A button in a panel: runs `command` with `argument`.
    record button {
        label: string,
        command: string,
        argument: string,
    }

    /// A run of text in a `spans` block. Colors are 0xRRGGBB.
    record span {
        text: string,
        color: option<u32>,
        bold: bool,
        monospace: bool,
    }

    record table {
        headers: list<string>,
        rows: list<list<string>>,
    }

    /// A piece of a panel declared in `plugin.toml`. Panels are declarative:
    /// the editor draws them with its own widgets.
    variant block {
        heading(string),
        text(string),
        code(string),
        bullets(list<string>),
        separator,
        button(button),
        /// Text with its own colors, on one line.
        spans(list<span>),
        table(table),
        /// Unified diff text, with added and removed lines colored.
        diff(string),
    }

    /// Colors part of a line. Colors are 0xRRGGBB.
    record decoration {
        /// 1-based line.
        line: u32,
        /// 0-based character columns, end exclusive.
        start: u32,
        end: u32,
        foreground: option<u32>,
        background: option<u32>,
        italic: bool,
    }

    enum severity {
        error,
        warning,
        information,
        hint,
    }

    /// An entry in the Problems panel, underlined in the editor.
    /// How often a line ran, for the coverage marks.
    record line-coverage {
        /// 1-based line.
        line: u32,
        hits: u64,
        /// It ran, but not every branch on it did.
        partial: bool,
    }

    record problem {
        /// 1-based line.
        line: u32,
        /// 0-based character columns, end exclusive.
        start: u32,
        end: u32,
        severity: severity,
        message: string,
    }

    /// The active editor.
    record document {
        /// Relative to the open folder ("" when the file is outside it or unsaved).
        path: string,
        language: string,
        text: string,
        /// 1-based cursor position.
        line: u32,
        column: u32,
        dirty: bool,
    }

    /// How a program started with `start-job` ended.
    record job-result {
        id: u64,
        /// None if it was stopped before exiting by itself.
        exit-code: option<s32>,
        stdout: string,
        stderr: string,
    }

    /// The answer to `language-server-request`.
    record server-response {
        id: u64,
        /// JSON; empty if it failed.
        answer: string,
        error: option<string>,
    }

    /// Something that happened in the editor. A plugin receives the kinds
    /// listed under `events` in its `plugin.toml`.
    variant event {
        /// A file was opened (relative path).
        opened(string),
        /// A file was saved (relative path).
        saved(string),
        /// Another editor became active (relative path, "" if none).
        active-changed(string),
        /// The active editor's text changed (relative path); sent once typing pauses.
        edited(string),
        /// A job this plugin started has ended. Always delivered.
        job-finished(job-result),
        /// A language server answered this plugin. Always delivered.
        server-answered(server-response),
    }
}

/// What the editor offers a plugin. Calls that read or change files or the
/// editor need a permission the user granted at install; without it they
/// return `permission denied: <permission>`.
interface host {
    use types.{line-coverage, tree-item, block, document, decoration, problem};

    /// A line in the plugin's log (Output panel).
    log: func(message: string);
    /// A short message in the status bar.
    show-message: func(message: string);

    /// Sets a status bar item declared in `plugin.toml`.
    set-status-item: func(id: string, text: string, tooltip: string);
    /// Replaces the rows of a tree view declared in `plugin.toml`.
    set-tree-items: func(view: string, items: list<tree-item>);
    /// Replaces the content of a panel declared in `plugin.toml`.
    set-panel: func(panel: string, blocks: list<block>);
    /// Replaces this plugin's coloring of a file (relative path, "" for the
    /// active editor). Empty clears it.
    set-decorations: func(path: string, items: list<decoration>);
    /// Replaces this plugin's problems for a file (relative path, "" for the
    /// active editor). Empty clears them.
    set-problems: func(path: string, items: list<problem>);
    /// Coverage marks for a file ("" for the active one), from a report format
    /// the editor doesn't read itself. An empty list clears them.
    set-coverage: func(path: string, lines: list<line-coverage>);
    /// Opens a file of the open folder at a 1-based line.
    open-location: func(path: string, line: u32) -> result<_, string>;

    /// Needs `workspace-read`: a text file of the open folder (relative path).
    read-file: func(path: string) -> result<string, string>;
    /// Needs `workspace-read`: relative paths of the open folder's files whose
    /// names end with `suffix` (all files for ""), at most `limit`.
    /// Ignored files (.gitignore, target) are skipped.
    list-files: func(suffix: string, limit: u32) -> result<list<string>, string>;
    /// Needs `workspace-write`: writes a file of the open folder.
    write-file: func(path: string, contents: string) -> result<_, string>;
    /// Needs `editor-read`: the active editor, if any.
    active-document: func() -> result<option<document>, string>;
    /// Needs `editor-write`: types `text` at the cursor of the active editor.
    insert-text: func(text: string) -> result<_, string>;

    /// Starts a program listed under `programs` in `plugin.toml`, which the user
    /// approved, in the open folder. It runs outside the sandbox, with the user's
    /// rights; the folder must be trusted. There's no time limit: it ends with a
    /// `job-finished` event. Every start is written to the plugin's log.
    start-job: func(program: string, args: list<string>, stdin: string) -> result<u64, string>;
    /// Stops a job. It still ends with a `job-finished` event.
    cancel-job: func(id: u64);
    /// Needs `language-server`: sends a request to the active file's language
    /// server, standard or custom. `params` is JSON; `textDocument` is added when
    /// missing. The answer comes as a `server-answered` event.
    language-server-request: func(method: string, params: string) -> result<u64, string>;
}

world plugin {
    use types.{event};
    import host;

    /// Called once after loading.
    export activate: func() -> result<_, string>;
    /// Runs a command declared in `plugin.toml` (or a tree row's or button's).
    export run-command: func(id: string, argument: string) -> result<_, string>;
    /// Delivers an event the plugin subscribed to.
    export on-event: func(event: event);
}

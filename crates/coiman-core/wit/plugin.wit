package coiman:plugin@0.6.0;

/// Data shared by the editor and plugins.
interface types {
    /// A row of a tree view declared in `plugin.toml`. Rows with an empty
    /// `parent` are top level; `command` (if any) runs when the row is clicked,
    /// with the row's `id` as its argument.
    record tree-item {
        id: string,
        parent: string,
        label: string,
        description: string,
        tooltip: string,
        command: option<string>,
    }

    /// A button in a panel: runs `command` with `argument`.
    record button {
        label: string,
        command: string,
        argument: string,
    }

    /// A run of text in a `spans` block. Colors are 0xRRGGBB.
    record span {
        text: string,
        color: option<u32>,
        bold: bool,
        monospace: bool,
    }

    record table {
        headers: list<string>,
        rows: list<list<string>>,
    }

    /// A line of a `links` block: a click opens the file at the line.
    record file-link {
        text: string,
        /// Dimmer, after the text.
        detail: string,
        /// Relative to the open folder.
        path: string,
        /// 1-based.
        line: u32,
    }

    /// A row of a `rows` block: coloured cells, then buttons.
    record row {
        cells: list<span>,
        buttons: list<button>,
    }

    enum field-kind {
        /// A line of text.
        text,
        /// On or off: its value is "true" or "false".
        check,
        /// One of `options`.
        choice,
        /// A line of text shown as dots (a password); the editor never keeps it after it closes.
        password,
        /// Lines of text (SQL, a script), as wide as the panel; Enter makes a new line.
        multiline,
        /// A small button showing `label`: pressing it sends the form, its id as the button.
        button,
        /// Not a field: what follows starts a new line.
        line-break,
    }

    /// A field of a form.
    record form-field {
        id: string,
        /// Shown before it ("" for none).
        label: string,
        kind: field-kind,
        /// What it holds at first. The editor keeps what the user types while the form is
        /// shown again; a different value sent sets it anew.
        value: string,
        /// A choice's options.
        options: list<string>,
        /// Shown while a text field is empty.
        hint: string,
    }

    /// Fields on one line, with buttons that send them (`form-submitted`); Enter in a text
    /// field sends with the first button.
    record form {
        id: string,
        fields: list<form-field>,
        buttons: list<string>,
    }

    /// What a form held when one of its buttons was pressed.
    record form-values {
        form: string,
        button: string,
        values: list<tuple<string, string>>,
    }

    /// A branch or tag on a commit of a `commit-graph`.
    record graph-ref {
        name: string,
        tag: bool,
        /// The branch checked out.
        current: bool,
    }

    /// One commit of a `commit-graph`, with the lines drawn through its row. Lanes count from
    /// 0 at the left.
    record commit-row {
        /// What clicks and menu items send as their argument (the commit's hash).
        id: string,
        /// The lane of its node.
        lane: u32,
        /// Lines in the row's top half: (lane at the top, lane at the middle).
        top: list<tuple<u32, u32>>,
        /// Lines in the bottom half: (lane at the middle, lane at the bottom).
        bottom: list<tuple<u32, u32>>,
        /// More than one parent: the node is filled.
        merge: bool,
        /// Checked out: the node is larger.
        head: bool,
        refs: list<graph-ref>,
        subject: string,
        /// Dimmer, at the right (hash, author, when).
        detail: string,
        /// What `{target}` in a menu item's label becomes for this row.
        target: string,
        /// What `{branch}` becomes; "" leaves out the items that name it.
        branch: string,
    }

    /// An item of a commit's right-click menu: runs `command` with the row's id. A label of
    /// "-" is a separator.
    record menu-item {
        label: string,
        command: string,
    }

    /// Commits drawn as a graph of branches and merges, newest first, in a scrolling list.
    record commit-graph {
        rows: list<commit-row>,
        /// The id of the row shown as chosen ("" for none).
        selected: string,
        /// Run with the row's id when one is clicked ("" for none).
        click: string,
        menu: list<menu-item>,
    }

    /// A piece of a panel declared in `plugin.toml`. Panels are declarative:
    /// the editor draws them with its own widgets.
    variant block {
        heading(string),
        text(string),
        code(string),
        bullets(list<string>),
        separator,
        button(button),
        /// Text with its own colors, on one line.
        spans(list<span>),
        table(table),
        /// Unified diff text, with added and removed lines colored.
        diff(string),
        /// Places in files, each opened by a click.
        links(list<file-link>),
        /// A grid of coloured cells with buttons at the end of each row.
        rows(list<row>),
        /// Fields to fill in, and buttons that send them.
        form(form),
        /// A commit graph with lanes; it scrolls by itself.
        commit-graph(commit-graph),
    }

    /// Colors part of a line. Colors are 0xRRGGBB.
    record decoration {
        /// 1-based line.
        line: u32,
        /// 0-based character columns, end exclusive.
        start: u32,
        end: u32,
        foreground: option<u32>,
        background: option<u32>,
        italic: bool,
    }

    enum severity {
        error,
        warning,
        information,
        hint,
    }

    /// An entry in the Problems panel, underlined in the editor.
    /// How often a line ran, for the coverage marks.
    record line-coverage {
        /// 1-based line.
        line: u32,
        hits: u64,
        /// It ran, but not every branch on it did.
        partial: bool,
    }

    record problem {
        /// 1-based line.
        line: u32,
        /// 0-based character columns, end exclusive.
        start: u32,
        end: u32,
        severity: severity,
        message: string,
    }

    /// The active editor.
    record document {
        /// Relative to the open folder ("" when the file is outside it or unsaved).
        path: string,
        language: string,
        text: string,
        /// 1-based cursor position.
        line: u32,
        column: u32,
        dirty: bool,
        /// What is selected (several selections one per line), "" for none. Current when a
        /// command of this plugin runs.
        selection: string,
    }

    /// How a program started with `start-job` ended.
    record job-result {
        id: u64,
        /// None if it was stopped before exiting by itself.
        exit-code: option<s32>,
        stdout: string,
        stderr: string,
    }

    /// The answer to `language-server-request`.
    record server-response {
        id: u64,
        /// JSON; empty if it failed.
        answer: string,
        error: option<string>,
    }

    /// A row of a pick list (`show-pick`).
    record pick-item {
        /// What is chosen: typed into the terminal, passed back in `picked`.
        text: string,
        /// A short word at the right: "history", "path"...
        kind: string,
        /// A dimmer note beside it.
        detail: string,
        /// Offers an X that sends `picked` with `forget`.
        can-forget: bool,
    }

    /// A list the user picks from, drawn by the editor. Typing narrows it: by the
    /// editor when `filter` is set, else the plugin gets `pick-query-changed` and
    /// shows the list again.
    record pick {
        /// The plugin's own name for it, passed back.
        id: string,
        title: string,
        /// What the box starts with.
        query: string,
        items: list<pick-item>,
        /// Shown below the terminal's cursor instead of at the top of the window.
        at-terminal-cursor: bool,
        /// Enter runs the choice (Shift+Enter only puts it), else the other way round.
        run-first: bool,
        filter: bool,
    }

    enum pick-action {
        /// Put it on the command line.
        put,
        /// Run it.
        run,
        /// Its X was clicked.
        forget,
    }

    record pick-choice {
        pick: string,
        text: string,
        action: pick-action,
    }

    record pick-query {
        pick: string,
        query: string,
    }

    /// The command line of a shell in a terminal.
    record terminal-line {
        terminal: u64,
        /// What comes after the prompt, up to the cursor.
        typed: string,
        /// The folder the prompt names, else the one the shell started in (absolute).
        dir: string,
    }

    record dir-entry {
        name: string,
        is-dir: bool,
    }

    /// A box of a graph (`show-graph`): a class, an interface, a module...
    record graph-node {
        /// Unique in the graph; edges name nodes by it.
        id: string,
        label: string,
        /// Shown above the name when not "class": "interface", "enum", "trait", "struct",
        /// "abstract", "external"...
        kind: string,
        /// The package, module or folder it belongs to.
        group: string,
        /// Lines listed in the box: "+ name: Type", "- count()".
        members: list<string>,
        /// Where it is, relative to the open folder ("" for none), and its 1-based line.
        path: string,
        line: u32,
        /// A colour for its border, 0xRRGGBB: tests green, a cycle red...
        accent: option<u32>,
    }

    /// How two nodes are related, drawn as UML draws it.
    enum edge-kind {
        /// `source` extends `target`: a solid line with a hollow triangle at `target`.
        inherits,
        /// `source` implements `target`: a dashed line with a hollow triangle at `target`.
        implements,
        /// `source` holds a `target` (a field): a solid line with a diamond at `source`.
        has,
        /// `source` uses `target`: a dashed arrow; `source` sits above `target`, so a graph of
        /// imports reads from the top down.
        uses,
    }

    record graph-edge {
        source: string,
        target: string,
        kind: edge-kind,
        label: string,
        /// A colour for the line, 0xRRGGBB.
        accent: option<u32>,
    }

    /// A graph drawn by the editor in a window: laid out with what is inherited above what
    /// inherits it, with zoom, filtering, a click to pick, a double click to open, and
    /// export to SVG, Mermaid and PlantUML.
    record graph {
        id: string,
        title: string,
        nodes: list<graph-node>,
        edges: list<graph-edge>,
        /// A node to pick and centre on.
        focus: option<string>,
    }

    /// A line above a line of a file, run as a plugin command when clicked.
    record code-lens {
        /// 1-based: the line it sits above.
        line: u32,
        title: string,
        /// Run with `argument` when clicked.
        command: string,
        argument: string,
    }

    /// A program to start, as `start-job` does, with more said about how.
    record job-spec {
        program: string,
        args: list<string>,
        stdin: string,
        /// Environment variables for this run only (a password, say: never in `args`, which
        /// other programs can see). `PATH` and the like can't be set.
        env: list<tuple<string, string>>,
        /// Run in this plugin's own folder rather than the open one.
        in-own-folder: bool,
    }

    /// A line a program started with `start-job-lines` printed (stdout or stderr).
    record job-line {
        id: u64,
        line: string,
    }

    /// A gdb session to start, attached to a program running under gdbserver.
    record remote-attach {
        /// The session's name, as the Debug view shows it.
        name: string,
        /// The same program on this machine (absolute, or relative to the open folder), for its
        /// symbols.
        program: string,
        /// What gdb connects to: `host:port`.
        target: string,
    }

    /// The time now.
    record clock {
        /// Milliseconds since 1970 (UTC).
        unix-millis: s64,
        /// How far local time is from UTC.
        utc-offset-minutes: s32,
    }

    /// A function, as the editor's own parser (tree-sitter) reads it.
    record function-info {
        name: string,
        /// 1-based.
        line: u32,
        lines: u32,
        /// Cyclomatic: 1, plus one per branch.
        complexity: u32,
    }

    /// Something that happened in the editor. A plugin receives the kinds
    /// listed under `events` in its `plugin.toml`.
    variant event {
        /// A file was opened (relative path).
        opened(string),
        /// A file was saved (relative path).
        saved(string),
        /// Another editor became active (relative path, "" if none).
        active-changed(string),
        /// The active editor's text changed (relative path); sent once typing pauses.
        edited(string),
        /// A job this plugin started has ended. Always delivered.
        job-finished(job-result),
        /// A language server answered this plugin. Always delivered.
        server-answered(server-response),
        /// A command was sent with Enter in a shell (`typed` is the command).
        terminal-command(terminal-line),
        /// Ctrl+Space in a shell: suggestions are asked for the line being typed.
        terminal-suggest(terminal-line),
        /// A row of this plugin's pick list was chosen. Always delivered.
        picked(pick-choice),
        /// The text in this plugin's pick list (without `filter`) changed. Always delivered.
        pick-query-changed(pick-query),
        /// What `continue-later` was given, once the editor has drawn a frame. Always delivered.
        resumed(string),
        /// A button of one of this plugin's forms was pressed. Always delivered.
        form-submitted(form-values),
        /// Files or folders of the open folder were deleted in the editor (relative paths).
        deleted(list<string>),
        /// A file or folder of the open folder was renamed in the editor (old, new; relative).
        renamed(tuple<string, string>),
        /// A line a job started with `start-job-lines` printed. Always delivered.
        job-line(job-line),
    }
}

/// What the editor offers a plugin. Calls that read or change files or the
/// editor need a permission the user granted at install; without it they
/// return `permission denied: <permission>`.
interface host {
    use types.{line-coverage, tree-item, block, document, decoration, problem, pick, terminal-line, dir-entry, graph, function-info, code-lens, clock, remote-attach, job-spec};

    /// A line in the plugin's log (Output panel).
    log: func(message: string);
    /// A short message in the status bar.
    show-message: func(message: string);

    /// Sets a status bar item declared in `plugin.toml`.
    set-status-item: func(id: string, text: string, tooltip: string);
    /// Replaces the rows of a tree view declared in `plugin.toml`.
    set-tree-items: func(view: string, items: list<tree-item>);
    /// Replaces the content of a panel declared in `plugin.toml`.
    set-panel: func(panel: string, blocks: list<block>);
    /// Replaces this plugin's coloring of a file (relative path, "" for the
    /// active editor). Empty clears it.
    set-decorations: func(path: string, items: list<decoration>);
    /// Replaces this plugin's problems for a file (relative path, "" for the
    /// active editor). Empty clears them.
    set-problems: func(path: string, items: list<problem>);
    /// Coverage marks for a file ("" for the active one), from a report format
    /// the editor doesn't read itself. An empty list clears them.
    set-coverage: func(path: string, lines: list<line-coverage>);
    /// Opens a file of the open folder at a 1-based line.
    open-location: func(path: string, line: u32) -> result<_, string>;

    /// Needs `workspace-read`: a text file of the open folder (relative path).
    read-file: func(path: string) -> result<string, string>;
    /// Needs `workspace-read`: relative paths of the open folder's files whose
    /// names end with `suffix` (all files for ""), at most `limit`.
    /// Ignored files (.gitignore, target) are skipped.
    list-files: func(suffix: string, limit: u32) -> result<list<string>, string>;
    /// Needs `workspace-write`: writes a file of the open folder, making its folders.
    write-file: func(path: string, contents: string) -> result<_, string>;
    /// Needs `editor-read`: the active editor, if any.
    active-document: func() -> result<option<document>, string>;
    /// Needs `editor-write`: types `text` at the cursor of the active editor.
    insert-text: func(text: string) -> result<_, string>;

    /// Starts a program listed under `programs` in `plugin.toml`, which the user
    /// approved, in the open folder. It runs outside the sandbox, with the user's
    /// rights; the folder must be trusted. There's no time limit: it ends with a
    /// `job-finished` event. Every start is written to the plugin's log.
    start-job: func(program: string, args: list<string>, stdin: string) -> result<u64, string>;
    /// Stops a job. It still ends with a `job-finished` event.
    cancel-job: func(id: u64);
    /// Needs `language-server`: sends a request to the active file's language
    /// server, standard or custom. `params` is JSON; `textDocument` is added when
    /// missing. The answer comes as a `server-answered` event.
    language-server-request: func(method: string, params: string) -> result<u64, string>;

    /// Shows a pick list; one per plugin, a new one replaces it. A pick with an
    /// empty title closes it.
    show-pick: func(pick: pick);
    /// Needs `workspace-read`: the open folder's path.
    workspace-path: func() -> result<string, string>;
    /// Needs `workspace-read` inside the open folder, `terminal` elsewhere: the
    /// files and folders in a folder (relative to the open folder, or absolute).
    read-dir: func(path: string) -> result<list<dir-entry>, string>;
    /// The plugin's own saved text (its settings, its history); "" at first.
    storage-read: func() -> string;
    /// Saves the plugin's own text, at most 4 MB. No permission needed.
    storage-write: func(text: string) -> result<_, string>;
    /// Needs `terminal`: the command line of the active shell, if it shows a prompt.
    active-terminal-line: func() -> result<option<terminal-line>, string>;
    /// Needs `terminal`: types text into a terminal. A carriage return runs the
    /// line; DEL (0x7f) erases the character before the cursor.
    terminal-type: func(terminal: u64, text: string) -> result<_, string>;
    /// Needs `terminal`: the commands in the shells' own history files (PowerShell,
    /// bash, zsh, fish), newest last.
    shell-history: func() -> result<list<string>, string>;

    /// Shows a graph in a window of its own; a new one with the same id replaces it, and one
    /// with an empty title closes it.
    show-graph: func(graph: graph);
    /// Asks to be called again with `resumed(token)`: long work goes on in steps, each
    /// within the time limit of one call, and the editor stays responsive in between.
    continue-later: func(token: string);

    /// Opens Markdown text as a page (rendered, read only) titled `title`.
    show-markdown: func(title: string, markdown: string);
    /// Runs an approved program (as `start-job` would) in a terminal tab of its own, where
    /// its output shows; the folder must be trusted. `python` is the project's interpreter.
    run-in-terminal: func(title: string, program: string, args: list<string>) -> result<_, string>;
    /// Needs `workspace-read`: the functions of a file of the open folder, with their length
    /// and complexity, from the editor's parser (Rust, Python, JavaScript, TypeScript, Java,
    /// C, C++, C#, Go); empty for other languages.
    syntax-functions: func(path: string) -> result<list<function-info>, string>;
    /// Needs `workspace-read`: opens what a commit changed in a file (relative to the open
    /// folder, which is a Git repository), in the editor's diff view.
    open-commit-diff: func(commit: string, path: string) -> result<_, string>;
    /// Needs `workspace-write`: renames a file of the open folder (both paths relative to it).
    rename-file: func(%from: string, to: string) -> result<_, string>;
    /// Needs `workspace-write`: lets a file of the open folder run as a program (does nothing on
    /// Windows, where scripts run by their kind).
    set-executable: func(path: string) -> result<_, string>;
    /// Needs `workspace-read`: opens how a file differs between two commits or branches (the
    /// first shown at the left) in the editor's diff view.
    open-compare-diff: func(base: string, other: string, path: string) -> result<_, string>;
    /// Puts text on the clipboard.
    copy-text: func(text: string);
    /// Opens the editor's Merge Conflicts window for the open folder.
    show-merge-conflicts: func();
    /// Needs `workspace-read`: opens a folder (absolute path) as the project, as Open Folder
    /// would. Running anything there still needs it trusted.
    open-folder: func(path: string) -> result<_, string>;
    /// Needs `editor-read`: the code lenses of a file of the open folder (relative path), in place
    /// of the ones this plugin set before; an empty list removes them.
    set-code-lenses: func(path: string, lenses: list<code-lens>);
    /// The time now.
    now: func() -> clock;
    /// A random number (for ids and test values; not for keys).
    random: func() -> u64;
    /// Needs `environment`: an environment variable of the editor's process.
    environment-variable: func(name: string) -> result<option<string>, string>;
    /// Opens text in a new, unsaved editor tab.
    open-text: func(text: string);
    /// Opens a web page (an `https://` or `http://` address) in the browser.
    open-url: func(url: string) -> result<_, string>;
    /// This plugin's own folder on disk (in the editor's config folder, never the project), with
    /// `sub` (a relative path, "" for none) made inside it: its absolute path. Programs a plugin
    /// starts with no folder open run here.
    data-folder: func(sub: string) -> result<string, string>;
    /// Writes a file in this plugin's own folder (relative path), making its folders.
    data-write: func(path: string, contents: string) -> result<_, string>;
    /// Deletes a file or folder (with what's in it) in this plugin's own folder; gone already is fine.
    data-remove: func(path: string) -> result<_, string>;
    /// Renames a file or folder in this plugin's own folder, replacing what `to` named.
    data-rename: func(%from: string, to: string) -> result<_, string>;
    /// As `start-job`, but what the program prints goes as it is into `file` in this plugin's own
    /// folder (an archive, say) instead of `job-result.stdout`.
    start-job-into: func(program: string, args: list<string>, stdin: string, file: string) -> result<u64, string>;
    /// As `start-job`, but run in this plugin's own folder, so paths in it can be given relative
    /// (some programs, like GNU tar, read `C:\…` as another machine's).
    start-data-job: func(program: string, args: list<string>, stdin: string) -> result<u64, string>;
    /// Needs `terminal`: the text of your ssh config file (`~/.ssh/config`), "" if there's none.
    ssh-config: func() -> result<string, string>;
    /// As `start-job`, but each line it prints comes as a `job-line` event as soon as it's
    /// printed (`job-finished` then has no output): for a program that runs on, like a server.
    start-job-lines: func(program: string, args: list<string>, stdin: string) -> result<u64, string>;
    /// Needs `workspace-read`: starts debugging with gdb attached to `target`, in the open
    /// folder (it must be trusted). Restarting the session runs this plugin's `restart`
    /// command, and its end runs `debug-ended`.
    debug-attach: func(attach: remote-attach) -> result<_, string>;
    /// A line in the Debug Console.
    debug-console: func(text: string);
    /// As `start-job`, with environment variables and where it runs.
    start-job-with: func(spec: job-spec) -> result<u64, string>;
}

world plugin {
    use types.{event};
    import host;

    /// Called once after loading.
    export activate: func() -> result<_, string>;
    /// Runs a command declared in `plugin.toml` (or a tree row's or button's).
    export run-command: func(id: string, argument: string) -> result<_, string>;
    /// Delivers an event the plugin subscribed to.
    export on-event: func(event: event);
}

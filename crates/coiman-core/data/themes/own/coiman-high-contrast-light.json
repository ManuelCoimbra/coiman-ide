{
  "name": "Coiman High Contrast Light",
  "type": "hc-light",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#000000",
    "foreground": "#000000",
    "descriptionForeground": "#2B2B2B",
    "focusBorder": "#0050A8",
    "activityBar.background": "#FFFFFF",
    "activityBar.activeBorder": "#0050A8",
    "sideBar.background": "#FFFFFF",
    "sideBar.foreground": "#000000",
    "sideBar.border": "#0050A8",
    "panel.border": "#0050A8",
    "editorGroup.border": "#0050A8",
    "tab.activeBackground": "#FFFFFF",
    "tab.activeForeground": "#000000",
    "tab.inactiveBackground": "#FFFFFF",
    "tab.inactiveForeground": "#2B2B2B",
    "statusBar.background": "#FFFFFF",
    "statusBar.foreground": "#000000",
    "editorLineNumber.foreground": "#3A3A3A",
    "editorLineNumber.activeForeground": "#000000",
    "editor.selectionBackground": "#A8D1FF",
    "editorCursor.foreground": "#000000",
    "editor.lineHighlightBorder": "#9A9A9A",
    "editorIndentGuide.background1": "#9A9A9A",
    "editorIndentGuide.activeBackground1": "#000000",
    "editorBracketMatch.border": "#B5200D",
    "editorBracketHighlight.foreground1": "#7A4A00",
    "editorBracketHighlight.foreground2": "#8A0080",
    "editorBracketHighlight.foreground3": "#00509E",
    "editorBracketHighlight.unexpectedBracket.foreground": "#B5200D",
    "gitDecoration.modifiedResourceForeground": "#7A4A00",
    "input.background": "#FFFFFF",
    "list.hoverBackground": "#E8E8E8"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#3A3A3A", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#0000B8" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#0B6100" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#8A0080" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#5A2D00" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.name.struct", "entity.name.enum"], "settings": { "foreground": "#00505A" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#5C1F00" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#000000" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#00509E" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#7A4A00" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#0050A8", "fontStyle": "bold" } },
    { "scope": ["invalid"], "settings": { "foreground": "#B5200D" } }
  ]
}

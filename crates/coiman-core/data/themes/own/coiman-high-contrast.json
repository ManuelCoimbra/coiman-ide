{
  "name": "Coiman High Contrast",
  "type": "hc",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#FFFFFF",
    "foreground": "#FFFFFF",
    "descriptionForeground": "#D6D6D6",
    "focusBorder": "#33E0FF",
    "activityBar.background": "#000000",
    "activityBar.activeBorder": "#33E0FF",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#FFFFFF",
    "sideBar.border": "#8FE8FF",
    "panel.border": "#8FE8FF",
    "editorGroup.border": "#8FE8FF",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#D6D6D6",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#FFFFFF",
    "editorLineNumber.foreground": "#C8C8C8",
    "editorLineNumber.activeForeground": "#FFFFFF",
    "editor.selectionBackground": "#1F5FA8",
    "editorCursor.foreground": "#FFFF00",
    "editor.lineHighlightBorder": "#5A5A5A",
    "editorIndentGuide.background1": "#5A5A5A",
    "editorIndentGuide.activeBackground1": "#FFFFFF",
    "editorBracketMatch.border": "#FFFF00",
    "editorBracketHighlight.foreground1": "#FFD700",
    "editorBracketHighlight.foreground2": "#FF8CFF",
    "editorBracketHighlight.foreground3": "#7CD8FF",
    "editorBracketHighlight.unexpectedBracket.foreground": "#FF5555",
    "gitDecoration.modifiedResourceForeground": "#FFD24D",
    "input.background": "#000000",
    "list.hoverBackground": "#1A1A1A"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#C8C8C8", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#FFD24D" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#9CFF8A" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#FFA6E0" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#7CD8FF" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.name.struct", "entity.name.enum"], "settings": { "foreground": "#7FFFD4" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#FFC799" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#FFFFFF" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#7CD8FF" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#FFD24D" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#33E0FF", "fontStyle": "bold" } },
    { "scope": ["invalid"], "settings": { "foreground": "#FF5555" } }
  ]
}

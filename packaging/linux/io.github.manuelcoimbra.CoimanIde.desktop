[Desktop Entry]
Type=Application
Name=Coiman IDE
GenericName=Code Editor
Comment=Edit, run, test and debug code
Exec=coiman-ide %F
Icon=io.github.manuelcoimbra.CoimanIde
Terminal=false
Categories=Development;IDE;TextEditor;
Keywords=code;editor;ide;programming;rust;python;java;
MimeType=text/plain;text/markdown;text/x-rust;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/x-java;text/x-go;text/x-shellscript;text/x-toml;text/x-yaml;text/javascript;application/javascript;application/json;application/xml;text/html;text/css;
StartupNotify=true
StartupWMClass=io.github.manuelcoimbra.CoimanIde

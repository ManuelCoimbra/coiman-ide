# Coiman IDE from the release's Linux archive, for the AUR. Releases fill in pkgver and the
# checksums.
pkgname=coiman-ide-bin
pkgver=0.4.1
pkgrel=1
pkgdesc="Code editor and IDE written in Rust (prebuilt)"
arch=('x86_64' 'aarch64')
url="https://github.com/ManuelCoimbra/coiman-ide"
license=('MIT')
depends=('glibc' 'gcc-libs' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcursor' 'libxrandr' 'libxi')
optdepends=('git: version control'
            'xdg-desktop-portal: file dialogs')
provides=('coiman-ide')
conflicts=('coiman-ide')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/coiman-ide-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/coiman-ide-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    cd "coiman-ide-$pkgver-linux-$CARCH"
    install -d "$pkgdir/usr"
    cp -R bin share "$pkgdir/usr/"
}
